aws_region   = "us-east-1"
environment  = "homolog"
state_bucket = "tc3-tfstate-oficina-SEUSUFIXO"

db_name           = "oficina_db"
db_username       = "oficina_user"
db_engine_version = "17"
db_instance_class = "db.t4g.micro"

# ─── Monitoria do banco ─────────────────────────────────────────────────────
# O agente roda no cluster e consulta o RDS direto, sem CloudWatch. Exige que
# tc3-infra-k8s já tenha aplicado: é de lá que vêm o namespace `newrelic` e a
# license key no SSM.
newrelic_namespace         = "newrelic"
db_monitor_user            = "newrelic_monitor"
newrelic_postgres_interval = "30s"

# `latest` sobe sem consulta prévia ao registry; travar numa tag concreta antes
# de promover para produção. As sondas usam /v1/status/health (agente ≥ 1.57).
newrelic_infra_bundle_tag = "latest"

# Tags padrão em toda telemetria — iguais às de tc3-infra-k8s e tc3-auth-lambda.
newrelic_tags = {
  environment = "production"
  project     = "tech-challenge-fiap"
}

# A license key NÃO entra aqui: é lida do SSM, onde tc3-infra-k8s a publica.

performance_insights_enabled = true
